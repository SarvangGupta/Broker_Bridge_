# ==============================================================================
# VetKind & BrokerBridge Platform Environment Configuration
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Database & Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Generative AI (Gemini) - Document Processing & Intelligence
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# WhatsApp Cloud API (Optional - External Notification Delivery)
WHATSAPP_API_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# Automation & Cron Secrets
CRON_SECRET="your-secure-cron-secret"
